rules_version='2';service cloud.firestore{match /databases/{d}/documents{match /{c}/{u}{allow read,delete:if request.auth!=null&&request.auth.uid==u&&c in ['profiles','demoRequests'];allow create,update:if request.auth!=null&&request.auth.uid==u&&c in ['profiles','demoRequests']&&request.resource.data.keys().hasOnly(['shop','language','updatedAt','email','message'])&&request.resource.data.shop is string&&request.resource.data.shop.size()<=120&&request.resource.data.language in ['English','Hindi','Marathi']&&request.resource.data.updatedAt==request.time&&(!('message' in request.resource.data)||(request.resource.data.message is string&&request.resource.data.message.size()<=1000));}}}